# Optional free-tier overrides. Defaults in app/config.py already match these values.
FREE_DAILY_TEXT_REQUESTS=5
FREE_MAX_OUTPUT_TOKENS=1024
FREE_DAILY_IMAGE_ANALYSES=1
FREE_DAILY_WEB_SEARCHES=2
FREE_DAILY_DOCUMENT_UPLOADS=2
FREE_DAILY_TRANSCRIPTION_SECONDS=300
FREE_DAILY_ENGLISH_TTS_CHARS=1000
FREE_DAILY_AI_BUDGET_USD=0.05
FREE_MAX_FILE_SIZE=5242880
MAX_MESSAGE_CHARS=8000

# Optional provider-rate overrides (USD rates per unit).
GROQ_TEXT_INPUT_USD_PER_M=0.15
GROQ_TEXT_OUTPUT_USD_PER_M=0.60
GROQ_VISION_INPUT_USD_PER_M=0.80
GROQ_VISION_OUTPUT_USD_PER_M=4.00
GROQ_WHISPER_USD_PER_HOUR=0.04
GROQ_ORPHEUS_USD_PER_M_CHARS=22.00
SERPER_USD_PER_SEARCH=0.001

# Adaptive text model routing. Add the real credentials as private Railway variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Sanctumly stops Qwen at 9,000 Neurons, leaving a 1,000-Neuron safety buffer.
CLOUDFLARE_DAILY_NEURON_BUDGET=9000
CLOUDFLARE_NEURONS_PER_ESTIMATED_TOKEN=0.04
CLOUDFLARE_MIN_NEURON_RESERVATION=10
CLOUDFLARE_FAILURE_COOLDOWN_SECONDS=60
CLOUDFLARE_FREE_MAX_OUTPUT_TOKENS=1024
CLOUDFLARE_CREATOR_MAX_OUTPUT_TOKENS=4096
