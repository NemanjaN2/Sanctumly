# Optional free-tier overrides. Defaults in app/config.py already match these values.
FREE_DAILY_TEXT_REQUESTS=5
FREE_MAX_OUTPUT_TOKENS=1024
FREE_DAILY_IMAGE_ANALYSES=1
FREE_DAILY_WEB_SEARCHES=2
FREE_DAILY_DOCUMENT_UPLOADS=2
FREE_DAILY_TRANSCRIPTION_SECONDS=300
FREE_DAILY_ENGLISH_TTS_CHARS=1000
FREE_DAILY_AI_BUDGET_USD=0.05
FREE_MAX_FILE_SIZE=5242880
MAX_MESSAGE_CHARS=8000

# Optional provider-rate overrides (USD rates per unit).
GROQ_TEXT_INPUT_USD_PER_M=0.15
GROQ_TEXT_OUTPUT_USD_PER_M=0.60
GROQ_VISION_INPUT_USD_PER_M=0.80
GROQ_VISION_OUTPUT_USD_PER_M=4.00
GROQ_WHISPER_USD_PER_HOUR=0.04
GROQ_ORPHEUS_USD_PER_M_CHARS=22.00
SERPER_USD_PER_SEARCH=0.001

# Adaptive text model routing. Add the real credentials as private Railway variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
# Sanctumly stops Cloudflare inference at 9,000 Neurons, leaving a 1,000-Neuron safety buffer.
CLOUDFLARE_DAILY_NEURON_BUDGET=9000
CLOUDFLARE_NEURONS_PER_ESTIMATED_TOKEN=0.04
CLOUDFLARE_MIN_NEURON_RESERVATION=10
CLOUDFLARE_FAILURE_COOLDOWN_SECONDS=60
CLOUDFLARE_FREE_MAX_OUTPUT_TOKENS=1024
CLOUDFLARE_CREATOR_MAX_OUTPUT_TOKENS=4096
GROQ_MODEL=openai/gpt-oss-120b

# Request-context budgets (estimated tokens; these are per-request context
# ceilings, not daily usage limits and not Creator account restrictions).
HISTORY_TOKEN_BUDGET=2200
CREATOR_HISTORY_TOKEN_BUDGET=4500
RETRIEVED_CONTEXT_TOKEN_BUDGET=2600
CREATOR_RETRIEVED_CONTEXT_TOKEN_BUDGET=4500
HISTORY_MSG_MAX_CHARS=1500
HISTORY_MSG_MAX_CHARS_CREATOR=5000
URL_CONTEXT_MAX_TOKENS=1800
RAG_CONTEXT_MAX_TOKENS=1600
SEARCH_CONTEXT_MAX_TOKENS=1800
MEMORY_CONTEXT_MAX_TOKENS=450
THERAPIST_CONTEXT_MAX_TOKENS=900

# GPT-OSS reasoning effort. Valid values: low, medium, high.
GROQ_REASONING_DEFAULT=low
GROQ_REASONING_DEEP=medium
GROQ_REASONING_CYBER=high

# Groq GPT-OSS automatic prompt caching discount. Applied only to cached
# tokens reported in usage; no manual cache enablement is required.
GROQ_PROMPT_CACHE_DISCOUNT=0.5
