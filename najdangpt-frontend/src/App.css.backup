:root {
  --bg-primary: #0f172a;
  --bg-secondary: #1e293b;
  --primary: #8b5cf6;
  --accent: #a78bfa;
  --text-primary: #f1f5f9;
  --text-secondary: #94a3b8;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background: linear-gradient(135deg, var(--bg-primary) 0%, #1a2332 100%);
  color: var(--text-primary);
  min-height: 100vh;
}

.gradient-text {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.glass-heavy {
  background: rgba(30, 41, 59, 0.7);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(139, 92, 246, 0.2);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

.btn {
  padding: 0.75rem 1.5rem;
  border-radius: 0.5rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  border: none;
  font-size: 1rem;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  color: white;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(139, 92, 246, 0.4);
}

.btn-primary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.btn-secondary {
  background: var(--bg-secondary);
  color: var(--text-primary);
  border: 1px solid var(--primary);
}

.btn-secondary:hover {
  background: rgba(139, 92, 246, 0.1);
  transform: translateY(-2px);
}

.input {
  width: 100%;
  padding: 0.75rem 1rem;
  background: var(--bg-secondary);
  border: 1px solid rgba(139, 92, 246, 0.3);
  border-radius: 0.5rem;
  color: var(--text-primary);
  font-size: 1rem;
  transition: all 0.3s ease;
}

.input:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
}

.message {
  max-width: 80%;
  padding: 1rem 1.5rem;
  border-radius: 1rem;
  animation: slideIn 0.3s ease;
}

.message-user {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  color: white;
  margin-left: auto;
}

.message-assistant {
  background: var(--bg-secondary);
  border: 1px solid rgba(139, 92, 246, 0.2);
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.typing-indicator {
  display: flex;
  gap: 0.5rem;
  padding: 0.5rem 0;
}

.typing-dot {
  width: 8px;
  height: 8px;
  background: var(--primary);
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) {
  animation-delay: -0.32s;
}

.typing-dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

/* ========================================
   SIDEBAR MENU STYLES (FIXED FOR MOBILE)
   ======================================== */

/* Hamburger Button */
.hamburger-button {
  background: var(--bg-secondary);
  border: 1px solid var(--primary);
  color: var(--primary);
  padding: 0.5rem 1rem;
  border-radius: 0.5rem;
  font-size: 1.5rem;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
  z-index: 10;
}

.hamburger-button:hover {
  background: var(--primary);
  color: var(--text-primary);
  transform: scale(1.05);
}

/* Sidebar */
.sidebar {
  position: fixed;
  left: -320px;
  top: 0;
  bottom: 0;
  width: 320px;
  background: var(--bg-secondary);
  border-right: 1px solid var(--primary);
  backdrop-filter: blur(20px);
  z-index: 9999;
  transition: left 0.3s ease;
  overflow-y: auto;
}

.sidebar-open {
  left: 0;
  box-shadow: 4px 0 24px rgba(139, 92, 246, 0.3);
}

/* Sidebar Header */
.sidebar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem;
  border-bottom: 1px solid rgba(139, 92, 246, 0.2);
  background: var(--bg-secondary);
}

.sidebar-close {
  background: transparent;
  border: none;
  color: var(--text-secondary);
  font-size: 1.5rem;
  cursor: pointer;
  padding: 0.5rem;
  transition: all 0.3s ease;
  z-index: 10000;
}

.sidebar-close:hover {
  color: var(--text-primary);
  transform: rotate(90deg);
}

/* Sidebar Content */
.sidebar-content {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.sidebar-section {
  border-bottom: 1px solid rgba(139, 92, 246, 0.1);
  padding-bottom: 1.5rem;
}

.sidebar-section:last-child {
  border-bottom: none;
}

/* Agent Buttons */
.agent-button {
  width: 100%;
  text-align: left;
  padding: 0.75rem 1rem;
  background: rgba(30, 41, 59, 0.5);
  border: 1px solid rgba(139, 92, 246, 0.2);
  border-radius: 0.5rem;
  color: var(--text-primary);
  font-size: 0.875rem;
  cursor: pointer;
  transition: all 0.3s ease;
}

.agent-button:hover {
  background: rgba(139, 92, 246, 0.2);
  border-color: var(--primary);
  transform: translateX(4px);
}

.agent-button-active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  border-color: var(--primary);
  font-weight: 600;
  box-shadow: 0 0 20px rgba(139, 92, 246, 0.4);
}

/* Sidebar Links */
.sidebar-link {
  display: block;
  width: 100%;
  text-align: left;
  padding: 0.75rem 1rem;
  background: transparent;
  border: 1px solid rgba(139, 92, 246, 0.2);
  border-radius: 0.5rem;
  color: var(--text-primary);
  font-size: 0.875rem;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.3s ease;
  margin-bottom: 0.5rem;
}

.sidebar-link:hover {
  background: rgba(139, 92, 246, 0.1);
  border-color: var(--primary);
  transform: translateX(4px);
}

.sidebar-link-danger {
  border-color: rgba(239, 68, 68, 0.3);
  color: #ef4444;
}

.sidebar-link-danger:hover {
  background: rgba(239, 68, 68, 0.1);
  border-color: #ef4444;
}

/* Sidebar Overlay */
.sidebar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 9998;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .sidebar {
    width: 85vw;
    max-width: 320px;
    left: -85vw;
  }
  
  .hamburger-button {
    padding: 0.5rem 0.75rem;
  }
  
  .sidebar-content {
    padding: 1rem;
  }
  
  .agent-button,
  .sidebar-link {
    font-size: 0.9rem;
    padding: 0.85rem 1rem;
  }
}
