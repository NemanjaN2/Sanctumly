:root {
  --bg-primary: #0f172a;
  --bg-secondary: #1e293b;
  --bg-tertiary: #334155;
  --primary: #8b5cf6;
  --accent: #a78bfa;
  --text-primary: #f1f5f9;
  --text-secondary: #94a3b8;
  --text-tertiary: #64748b;
  --success: #10b981;
  --error: #ef4444;
  --warning: #f59e0b;
  --border-subtle: rgba(139, 92, 246, 0.15);
  --border-normal: rgba(139, 92, 246, 0.25);
  --border-strong: rgba(139, 92, 246, 0.4);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
  background: var(--bg-primary);
  color: var(--text-primary);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Custom Scrollbar - Subtle and minimal */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(139, 92, 246, 0.2);
  border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(139, 92, 246, 0.35);
}

* {
  scrollbar-width: thin;
  scrollbar-color: rgba(139, 92, 246, 0.2) transparent;
}

.gradient-text {
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.glass-heavy {
  background: rgba(30, 41, 59, 0.5);
  backdrop-filter: blur(12px);
  border: 1px solid var(--border-subtle);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
}

/* Buttons - Professional and minimal */
.btn {
  padding: 0.625rem 1rem;
  border-radius: 0.5rem;
  font-weight: 500;
  font-size: 0.875rem;
  cursor: pointer;
  transition: all 0.15s ease;
  border: none;
  position: relative;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  white-space: nowrap;
}

.btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.btn-primary {
  background: var(--primary);
  color: white;
}

.btn-primary:hover:not(:disabled) {
  background: var(--accent);
}

.btn-primary:active:not(:disabled) {
  transform: scale(0.98);
}

.btn-secondary {
  background: transparent;
  color: var(--text-primary);
  border: 1px solid var(--border-normal);
}

.btn-secondary:hover:not(:disabled) {
  background: rgba(139, 92, 246, 0.1);
  border-color: var(--border-strong);
}

.btn-icon {
  width: 36px;
  height: 36px;
  padding: 0;
  border-radius: 0.5rem;
}

/* Input - Minimal and clean */
.input {
  width: 100%;
  padding: 0.75rem 1rem;
  background: rgba(30, 41, 59, 0.5);
  border: 1px solid var(--border-subtle);
  border-radius: 0.5rem;
  color: var(--text-primary);
  font-size: 0.9375rem;
  transition: all 0.15s ease;
  font-family: inherit;
}

.input:focus {
  outline: none;
  border-color: var(--primary);
  background: rgba(30, 41, 59, 0.7);
}

.input::placeholder {
  color: var(--text-tertiary);
}

/* Messages - Clean and readable */
.message {
  max-width: 85%;
  padding: 0.75rem 1rem;
  border-radius: 1.25rem;
  animation: messageSlideIn 0.2s ease;
  word-wrap: break-word;
  line-height: 1.6;
  font-size: 0.9375rem;
}

.message-user {
  background: var(--primary);
  color: white;
  margin-left: auto;
  border-bottom-right-radius: 0.25rem;
}

.message-assistant {
  background: rgba(30, 41, 59, 0.6);
  border: 1px solid var(--border-subtle);
  border-bottom-left-radius: 0.25rem;
  color: var(--text-primary);
}

@keyframes messageSlideIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Typing Indicator - Subtle */
.typing-indicator {
  display: flex;
  gap: 0.375rem;
  padding: 0.75rem 1rem;
  align-items: center;
}

.typing-dot {
  width: 6px;
  height: 6px;
  background: var(--text-tertiary);
  border-radius: 50%;
  animation: typingBounce 1.2s infinite ease-in-out;
}

.typing-dot:nth-child(1) {
  animation-delay: -0.32s;
}

.typing-dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes typingBounce {
  0%, 80%, 100% {
    transform: scale(0.8);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* Feedback Buttons - Minimal */
.feedback-btn {
  padding: 0.25rem;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 0.375rem;
  color: var(--text-tertiary);
  cursor: pointer;
  transition: all 0.15s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 24px;
  height: 24px;
}

.feedback-btn:hover {
  background: rgba(139, 92, 246, 0.1);
  border-color: var(--border-subtle);
  color: var(--text-secondary);
}

.feedback-btn.feedback-active {
  background: rgba(139, 92, 246, 0.15);
  border-color: var(--border-normal);
  color: var(--primary);
}

.feedback-btn svg {
  width: 14px;
  height: 14px;
}

/* Voice Recording Pulse */
@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.6;
  }
}

/* Markdown Content - Professional typography */
.markdown-content {
  line-height: 1.65;
  font-size: 0.9375rem;
}

.markdown-content h1 {
  font-size: 1.5rem;
  font-weight: 600;
  margin-top: 1.5rem;
  margin-bottom: 0.75rem;
  color: var(--text-primary);
}

.markdown-content h2 {
  font-size: 1.25rem;
  font-weight: 600;
  margin-top: 1.25rem;
  margin-bottom: 0.625rem;
  color: var(--text-primary);
}

.markdown-content h3 {
  font-size: 1.0625rem;
  font-weight: 600;
  margin-top: 1rem;
  margin-bottom: 0.5rem;
  color: var(--text-primary);
}

.markdown-content p {
  margin-bottom: 1rem;
}

.markdown-content ul,
.markdown-content ol {
  margin-left: 1.5rem;
  margin-bottom: 1rem;
  padding-left: 0.5rem;
}

.markdown-content li {
  margin-bottom: 0.375rem;
}

.markdown-content strong {
  font-weight: 600;
  color: var(--text-primary);
}

.markdown-content em {
  font-style: italic;
}

.markdown-content code {
  background: rgba(139, 92, 246, 0.1);
  padding: 0.125rem 0.375rem;
  border-radius: 0.25rem;
  font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', 'Courier New', monospace;
  font-size: 0.875em;
  color: var(--accent);
  border: 1px solid var(--border-subtle);
}

.markdown-content pre {
  background: rgba(15, 23, 42, 0.6);
  padding: 1rem;
  border-radius: 0.5rem;
  overflow-x: auto;
  margin-bottom: 1rem;
  border: 1px solid var(--border-subtle);
}

.markdown-content pre code {
  background: transparent;
  padding: 0;
  color: var(--text-primary);
  border: none;
}

.markdown-content blockquote {
  border-left: 3px solid var(--primary);
  padding-left: 1rem;
  margin-left: 0;
  margin-bottom: 1rem;
  margin-top: 1rem;
  font-style: italic;
  opacity: 0.85;
  color: var(--text-secondary);
}

.markdown-content a {
  color: var(--primary);
  text-decoration: underline;
  text-decoration-color: rgba(139, 92, 246, 0.4);
  transition: all 0.15s ease;
}

.markdown-content a:hover {
  color: var(--accent);
  text-decoration-color: var(--accent);
}

.markdown-content hr {
  border: none;
  border-top: 1px solid var(--border-subtle);
  margin: 1.5rem 0;
}

.markdown-content table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 1rem;
  border: 1px solid var(--border-subtle);
  border-radius: 0.5rem;
  overflow: hidden;
  font-size: 0.875rem;
}

.markdown-content th,
.markdown-content td {
  border: 1px solid var(--border-subtle);
  padding: 0.625rem 0.75rem;
  text-align: left;
}

.markdown-content th {
  background: rgba(139, 92, 246, 0.08);
  font-weight: 600;
  color: var(--text-primary);
}

.markdown-content td {
  color: var(--text-secondary);
}

/* Empty State - Clean and minimal */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem 2rem;
  text-align: center;
  animation: fadeIn 0.4s ease;
  max-width: 700px;
  margin: 0 auto;
}

.empty-state-icon {
  width: 64px;
  height: 64px;
  margin-bottom: 1.5rem;
  opacity: 0.15;
}

.empty-state-title {
  font-size: 1.5rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: var(--text-primary);
}

.empty-state-subtitle {
  font-size: 0.9375rem;
  color: var(--text-secondary);
  margin-bottom: 2rem;
  max-width: 480px;
}

.empty-state-suggestions {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 0.75rem;
  width: 100%;
  max-width: 600px;
}

.suggestion-card {
  padding: 1rem;
  background: rgba(30, 41, 59, 0.4);
  border: 1px solid var(--border-subtle);
  border-radius: 0.75rem;
  cursor: pointer;
  transition: all 0.15s ease;
  text-align: left;
}

.suggestion-card:hover {
  background: rgba(139, 92, 246, 0.1);
  border-color: var(--border-normal);
  transform: translateY(-1px);
}

.suggestion-icon {
  font-size: 1.25rem;
  margin-bottom: 0.5rem;
  opacity: 0.5;
}

.suggestion-text {
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.4;
}

/* Tooltip - Subtle */
.tooltip {
  position: relative;
  display: inline-block;
}

.tooltip::after {
  content: attr(data-tooltip);
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(-4px);
  padding: 0.375rem 0.625rem;
  background: rgba(15, 23, 42, 0.95);
  color: var(--text-primary);
  font-size: 0.75rem;
  border-radius: 0.375rem;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
  border: 1px solid var(--border-normal);
  z-index: 1000;
}

.tooltip:hover::after {
  opacity: 1;
  transform: translateX(-50%) translateY(-8px);
}

/* File Upload - Clean */
.upload-progress {
  margin-top: 0.75rem;
}

.progress-bar {
  width: 100%;
  height: 4px;
  background: rgba(30, 41, 59, 0.6);
  border-radius: 2px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 2px;
  transition: width 0.3s ease;
}

/* Messages - Error and Success */
.error-message {
  padding: 0.875rem 1rem;
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.3);
  border-radius: 0.5rem;
  color: #fca5a5;
  display: flex;
  align-items: center;
  gap: 0.625rem;
  font-size: 0.875rem;
}

.success-message {
  padding: 0.875rem 1rem;
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.3);
  border-radius: 0.5rem;
  color: #6ee7b7;
  display: flex;
  align-items: center;
  gap: 0.625rem;
  font-size: 0.875rem;
}

/* Hamburger Button - Minimal */
.hamburger-button {
  background: transparent;
  border: 1px solid var(--border-normal);
  color: var(--text-primary);
  width: 36px;
  height: 36px;
  border-radius: 0.5rem;
  cursor: pointer;
  transition: all 0.15s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hamburger-button:hover {
  background: rgba(139, 92, 246, 0.1);
  border-color: var(--primary);
}

.hamburger-button svg {
  width: 20px;
  height: 20px;
}

/* Sidebar - Professional and clean */
.sidebar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  z-index: 99998;
  animation: fadeIn 0.2s ease;
}

.sidebar {
  position: fixed;
  left: -100%;
  top: 0;
  bottom: 0;
  width: 280px;
  max-width: 85vw;
  background: var(--bg-primary);
  border-right: 1px solid var(--border-normal);
  z-index: 99999;
  transition: left 0.25s ease;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.sidebar-open {
  left: 0 !important;
}

.sidebar-header {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  background: var(--bg-primary);
  z-index: 10;
}

.sidebar-title {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.sidebar-close {
  background: transparent;
  border: none;
  color: var(--text-tertiary);
  cursor: pointer;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0.375rem;
  transition: all 0.15s ease;
}

.sidebar-close:hover {
  color: var(--text-primary);
  background: rgba(139, 92, 246, 0.1);
}

.sidebar-content {
  padding: 1rem 1.25rem;
  flex: 1;
}

.sidebar-section {
  margin-bottom: 1.5rem;
}

.sidebar-section-title {
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-tertiary);
  margin-bottom: 0.75rem;
}

.agent-button {
  width: 100%;
  text-align: left;
  padding: 0.625rem 0.75rem;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 0.5rem;
  color: var(--text-secondary);
  font-size: 0.875rem;
  cursor: pointer;
  transition: all 0.15s ease;
  margin-bottom: 0.375rem;
  display: flex;
  align-items: center;
  gap: 0.625rem;
}

.agent-button:hover {
  background: rgba(139, 92, 246, 0.08);
  color: var(--text-primary);
}

.agent-button-active {
  background: rgba(139, 92, 246, 0.15);
  color: var(--primary);
  font-weight: 500;
}

.agent-label {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-link {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  width: 100%;
  text-align: left;
  padding: 0.625rem 0.75rem;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 0.5rem;
  color: var(--text-secondary);
  font-size: 0.875rem;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.15s ease;
  margin-bottom: 0.375rem;
}

.sidebar-link:hover {
  background: rgba(139, 92, 246, 0.08);
  color: var(--text-primary);
}

.sidebar-link-danger {
  color: #ff6b6b;
}

.sidebar-link-danger:hover {
  background: rgba(239, 68, 68, 0.1);
  color: #ff6b6b;
}

/* User badge in sidebar */
.user-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.25rem 0.5rem;
  background: rgba(139, 92, 246, 0.15);
  border: 1px solid var(--border-normal);
  border-radius: 0.375rem;
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--primary);
}

/* Body scroll lock */
body.sidebar-open {
  overflow: hidden;
}

/* Responsive */
@media (max-width: 768px) {
  .sidebar {
    width: 85vw;
  }
  
  .message {
    max-width: 90%;
  }
  
  .empty-state {
    padding: 2rem 1rem;
  }
  
  .empty-state-suggestions {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 480px) {
  .message {
    max-width: 95%;
    padding: 0.625rem 0.875rem;
    font-size: 0.875rem;
  }
  
  .sidebar-header {
    padding: 0.875rem 1rem;
  }
  
  .sidebar-content {
    padding: 0.875rem 1rem;
  }
}
